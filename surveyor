class ExecutionController:
    "Small Handler for determining if a pipeline step must be run"
    STEPS = [   "init" , "config", "contig_mapping", "is_params",
                "isolation", "primary_aln", "clean_sort", "extract_clips",
                "clip_aln", "collect_aln", "enum_chimera", "enum_edge",
                "edge_mapping", "collect_reads", "dust_filter",
                "make_bed", "adj_coverage", "filter", "terminate"
            ]
    def __init__(self, force_from=None):
        if force_from is None:
            force_from = "terminate"
        force_from = force_from.lower()
        if force_from not in self.STEPS:
            raise ValueError(
                f"Unknown force_from argument '{force_from}'. "
                f"Valid steps: {', '.join(self.STEPS)}"
            )

        self.force_from = force_from
        self.force_index = self.STEPS.index(self.force_from)
        self.force = False

    def should_execute(self, step, targets=None):
        if step not in self.STEPS:
            raise ValueError(f"Unknown pipeline step: {step}")
        step_index = self.STEPS.index(step)
        forced = step_index >= self.force_index
        if forced:
            self.force = True
        if targets is not None and not isinstance(targets, (list, tuple, set)):
            targets = [ targets ]
        return self.force or (targets is not None and not all(
            os.path.isfile(target) for target in targets
        ))


