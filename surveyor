#Returns true if the config file needs to updates
#Return false if it does not,
#Throws value error if the current settings would result in
# an unexpected update
def check_config():
    "Compare the current setting to the saved settings"
    if missing_file(PATH_DICT["config"]):
        return True
    needs_update = False
    with open(PATH_DICT["config"], encoding ="utf-8") as config:
        for line in config:
            tag,value = line.strip().split()
            req_force_from = None
            argVal = None
            match tag:
                case "threads":
                    argVal = cmd_args.threads
                    value = int(value)
                    req_force_from = "terminate"
                case "read_len":
                    pass
                case "min_sc_size":
                    argVal = cmd_args.minClipSize
                    value = int(value)
                    req_force_from = "extract_clips"
                case "max_sc_dist":
                    argVal = cmd_args.maxSCDist
                    value = int(value)
                    req_force_from = "edge_mapping"
                case "max_alt_aln":
                    argVal = cmd_args.maxAltAln
                    value = int(value)
                    req_force_from = "clean_sort"
                case "explore":
                    argVal = cmd_args.exploratory
                    value = eval(value)
                    req_force_from = "edge_mapping"
                case "clique":
                    argVal = cmd_args.cliqueClusters
                    value = eval(value)
                    req_force_from = "enum_edge"
                case "min_frag":
                    argVal = cmd_args.minFrag
                    value = int(value)
                    req_force_from = "enum_edge"
                case "split_bonus":
                    argVal = cmd_args.splitBonus
                    value = int(value)
                    req_force_from = "enum_edge"
                case "max_used_frac":
                    argVal = cmd_args.maxUsedFrac
                    value = float(value)
                    req_force_from = "edge_mapping"
                case "max_raw_alt_dist":
                    argVal = cmd_args.maxRawAltDist
                    value = int(value)
                    req_force_from = "filter"
                case "max_prop_alt_dist":
                    argVal = cmd_args.maxPropAltDist
                    value = float(value)
                    req_force_from = "filter"
                case _:
                    raise ValueError(f"Unrecognized tag {tag} in saved config")
            if(argVal is not None and argVal != value):
                needs_update = True
                req_force_index = ExecutionController.STEPS.index(req_force_from)
                if(executor.force_index > req_force_index):
                    raise ValueError( f"Saved config {tag} value {value} does"
                                      f" not match command line argument"
                                      f" {argVal}; update the config file, use"
                                      f" force_from {req_force_from}, use"
                                      f" --clean_first, or specify a new"
                                      f" workdir" )
    return needs_update

