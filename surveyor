if not cmd_args.keep:
    eprint("Cleaning up intermediary files ...")
    while CLEANUP_PATH_LIST:
        path = CLEANUP_PATH_LIST.pop()
        #Check if the path is a link. We do this first to prevent possible circularity
        # and to prevent undesired deletion of linked data
        if os.path.islink(path):
            os.unlink(path)
        elif os.path.isdir(path): #Check if directory
            dir = os.listdir(path) #Check for files in the folder
            if len(dir) == 0: #If not, go ahead and remove it
                os.rmdir(path)
            else: #Otherwise put it back, and add all of its children to be processed first
                CLEANUP_PATH_LIST.append(path)
                for child in dir:
                    CLEANUP_PATH_LIST.append(os.path.join(path,child))
        elif os.path.isfile(path): #its a file, just delete it
            os.remove(path)


